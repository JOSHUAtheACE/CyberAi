# SENTINEL AI — environment template
# Copy to .env (or export in the process environment) before running in production.
# Never commit a populated .env file, and never expose these values to the browser.

# ---------------------------------------------------------------------------
# Session security
# ---------------------------------------------------------------------------
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# When unset, a development secret is persisted to backend/data/.secret_key.
SENTINEL_SECRET_KEY=

# Session lifetime in minutes (default 480).
SENTINEL_TOKEN_TTL_MINUTES=480

# Cookie flags. Set SENTINEL_COOKIE_SECURE=true behind HTTPS.
SENTINEL_COOKIE_SECURE=false
SENTINEL_COOKIE_SAMESITE=lax

# Comma-separated browser origins allowed to call the API.
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite by default (the supported, tested configuration). A PostgreSQL URL can be
# supplied only after installing a driver such as psycopg yourself; PostgreSQL is not
# exercised by this release and the single-worker runtime assumptions still apply.
SENTINEL_DATABASE_URL=
SENTINEL_DATA_DIR=
SENTINEL_MODEL_DIR=

# Maximum upload size in megabytes (default 50).
SENTINEL_MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# Seeded accounts (development / demo)
# ---------------------------------------------------------------------------
# Change these before any shared deployment. Passwords are hashed with scrypt.
SENTINEL_DEMO_ENABLED=true
SENTINEL_DEMO_PASSWORD=Sentinel!Demo2026
SENTINEL_ADMIN_EMAIL=admin@sentinela.ai
SENTINEL_ADMIN_PASSWORD=Sentinel!Demo2026

# Skip demo seeding entirely (empty database, no demo workspace).
# SENTINEL_SKIP_SEED=true

# ---------------------------------------------------------------------------
# Threat intelligence — external enrichment is OFF by default
# ---------------------------------------------------------------------------
# Enabling this permits outbound lookups for public indicators only. Private,
# loopback, link-local and documentation addresses are always rejected. This
# switch does not by itself enable any provider; each provider must also be
# enabled from the Threat intelligence console after change approval.
SENTINEL_ALLOW_EXTERNAL_ENRICHMENT=false

# Provider credentials are read server-side only. They are never returned to
# the browser, never written to logs, and are surfaced in the UI only as
# environment-variable names with present/missing state.
THREATFOX_AUTH_KEY=
URLHAUS_AUTH_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Local MaxMind database path (optional; overrides web-service lookups).
MAXMIND_DB_PATH=

# ---------------------------------------------------------------------------
# Optional local model assistance
# ---------------------------------------------------------------------------
# Reserved. No language model is called in this release; insights are computed
# deterministically from stored telemetry. Leave disabled.
SENTINEL_LLM_ENABLED=false
